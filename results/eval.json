  "rules": [
    {
      "id": "R001",
      "name": "Credential stuffing from a single IP",
      "mitre": "T1110.004 Brute Force - Credential Stuffing",
      "severity": "high",
      "entity": "ip",
      "description": "One IP fails logins on many different accounts inside an hour.",
      "response": "Block the IP for 24 h at the edge and require a CAPTCHA on its next 100 logins.",
      "false_positives": "Carrier-grade NAT or a shared office egress; mitigated by the 75% failure floor."
    },
    {
      "id": "R002",
      "name": "Distributed credential stuffing from one network (ASN)",
      "mitre": "T1110.004 Brute Force - Credential Stuffing",
      "severity": "high",
      "entity": "asn",
      "description": "A botnet rotates IPs to stay under per-IP limits, but its traffic still concentrates in a few networks.",
      "response": "Step up to CAPTCHA plus email verification for logins from this ASN for 6 h; block the top source IPs.",
      "false_positives": "A large VPN provider during a regional outage."
    },
    {
      "id": "R003",
      "name": "Password spraying (one password across many accounts)",
      "mitre": "T1110.003 Brute Force - Password Spraying",
      "severity": "high",
      "entity": "pw_hash",
      "description": "The same keyed hash of an attempted password fails on many accounts. Only a 12-character keyed hash is logged, never the password.",
      "response": "Add the hash to the banned-password list, force reset on any account where it succeeded, and block the source IPs.",
      "false_positives": "None expected; legitimate users do not share passwords across accounts."
    },
    {
      "id": "R004",
      "name": "Impossible travel on a new device",
      "mitre": "T1078 Valid Accounts",
      "severity": "low",
      "entity": "account_id",
      "description": "Two successful logins imply faster than 900 km/h travel over 1,000+ km, and the second login uses a device fingerprint the account has never used.",
      "response": "Revoke active sessions and require re-authentication with the second factor.",
      "false_positives": "VPN users; suppressed by requiring a never-seen device fingerprint."
    },
    {
      "id": "R005",
      "name": "Login from new network and device, then account manipulation",
      "mitre": "T1098 Account Manipulation",
      "severity": "critical",
      "entity": "account_id",
      "description": "A successful login from an ASN and device fingerprint the account has never used is followed within 2 h by an MFA, email or device-pairing change.",
      "response": "Freeze the account, roll back the MFA and email changes, unpair the new device, and notify the user through the original email.",
      "false_positives": "A user who buys a new phone while travelling and re-pairs a device the same day."
    },
    {
      "id": "R006",
      "name": "Cloned device identity",
      "mitre": "T1036 Masquerading",
      "severity": "high",
      "entity": "device_id",
      "description": "One device serial checks in from two or more networks inside 6 h. Home devices check in from one fixed network.",
      "response": "Rotate the device credential, quarantine check-ins from the new network, and ask the owner to re-pair.",
      "false_positives": "A user moving house or an ISP renumbering their block."
    },
    {
      "id": "R007",
      "name": "Device ID enumeration through the API",
      "mitre": "T1087 Account Discovery",
      "severity": "medium",
      "entity": "account_id",
      "description": "One account requests many distinct device IDs in 10 minutes and most return 4xx, the signature of walking a sequential ID space.",
      "response": "Revoke the API token, rate-limit the account to 1 request/s, and switch device IDs to unguessable values.",
      "false_positives": "A buggy client retry loop; distinct-ID floor of 50 keeps those out."
    },
    {
      "id": "R008",
      "name": "Signup burst from one device fingerprint",
      "mitre": "T1585 Establish Accounts",
      "severity": "medium",
      "entity": "device_fp",
      "description": "Five or more new accounts are created from one device fingerprint in 24 h.",
      "response": "Hold promo payouts for these accounts and require phone verification.",
      "false_positives": "A family setting up accounts on one shared tablet; usually 2 to 4 accounts."
    },
    {
      "id": "R009",
      "name": "Spike in failed logins on non-existent usernames",
      "mitre": "T1110.004 Brute Force - Credential Stuffing",
      "severity": "medium",
      "entity": "global",
      "description": "Leaked combo lists contain usernames the service never had. A rise in failures on unknown usernames, over a trailing 7-day hourly baseline, exposes low-and-slow stuffing that per-IP and per-ASN rules miss.",
      "response": "Turn on site-wide step-up (CAPTCHA) for logins from never-seen devices until the rate returns to baseline.",
      "false_positives": "An app release that breaks username normalization."
    }
  ]
}